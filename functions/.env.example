# Copy to .env before deploy (do not commit .env)
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    Paste the 16-character password below (spaces optional, they will be stripped).
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
# The "From" line readers see in their inbox. The address MUST be the same
# Gmail account above (Gmail rewrites any other From address to GMAIL_USER).
EMAIL_FROM=Booqly <your.address@gmail.com>
