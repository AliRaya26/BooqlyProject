rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ────────────────────────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Books (read-only for signed-in users) ─────────────────────────────────
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /feedbacks/{feedbackId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && feedbackId.matches('^fb_[1-5]$')
          && request.resource.data.bookId == bookId
          && request.resource.data.keys().hasAll(['bookId', 'userName', 'rating', 'comment', 'createdAt'])
          && request.resource.data.userName is string
          && request.resource.data.userName.size() >= 2
          && request.resource.data.userName.size() <= 40
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 10
          && request.resource.data.comment.size() <= 500
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update, delete: if false;
      }
    }

    // ── App config (read-only) ────────────────────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── User preferences ──────────────────────────────────────────────────────
    match /preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Owner: full access. Others: read public profile fields (Friends search).
      allow read: if request.auth != null;
      allow write: if isOwner(userId);

      // ── Library ──────────────────────────────────────────────────────────
      match /library/{bookId} {
        allow read, write: if isOwner(userId);

        // Notes & Highlights — private to owner
        match /notes/{noteId} {
          allow read, write: if isOwner(userId);
        }
      }

      // ── Reading Sessions ──────────────────────────────────────────────────
      match /readingSessions/{sessionId} {
        // Owner writes; followed users' sessions are read via Cloud Functions
        // or directly when building the activity feed (same-user read pattern).
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }

      // ── Reading Goals ─────────────────────────────────────────────────────
      match /goals/{year} {
        allow read, write: if isOwner(userId);
      }

      // ── Reading Preferences ───────────────────────────────────────────────
      match /reading_preferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ── Following list ────────────────────────────────────────────────────
      // Owner manages; any signed-in user can read (for activity feed queries).
      match /following/{targetId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId);
      }
    }

    // ── Email index (pre-signup check) ────────────────────────────────────────
    match /email_index/{email} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Outbound mail queue ───────────────────────────────────────────────────
    match /mail/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.message is map
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.html is string
        && request.resource.data.message.subject.size() > 0
        && request.resource.data.message.subject.size() < 200
        && request.resource.data.message.html.size() > 0
        && request.resource.data.message.html.size() < 20000;
      allow update, delete: if false;
    }
  }
}
